# Supabase publishable browser configuration.
# Never place a service-role key in a VITE_* variable or extension bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key
# Optional URL configured in Supabase Auth for email confirmation redirects.
VITE_EMAIL_REDIRECT_URL=https://example.com/verify/email.html
# Optional operator-owned HEIC conversion endpoint.
VITE_HEIC_CONVERTER_URL=https://example.com/api/convert-heic
